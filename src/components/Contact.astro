<section class="contact" id="contact">
  <div class="section-label">
    <span class="lang-en">CONTACT</span>
    <span class="lang-es">CONTACTO</span>
  </div>
  <div class="contact-content">
    <a href="mailto:eric.chavarria1409@gmail.com" class="contact-email">
      eric.chavarria1409@gmail.com
    </a>
    <p class="contact-note">
      <span class="lang-en">*only send email for working purpose</span>
      <span class="lang-es">*solo enviar email para fines laborales</span>
    </p>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding: 6rem 3rem;
    padding-left: 6rem;
    max-width: 900px;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-email {
    font-size: 2rem;
    font-weight: 300;
    color: var(--color-text);
    letter-spacing: -0.02em;
    transition: opacity 0.2s;
    word-break: break-all;
  }

  .contact-email:hover {
    opacity: 0.7;
  }

  .contact-note {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .contact {
      grid-template-columns: 1fr;
      padding: 4rem 1.5rem;
      gap: 1rem;
    }

    .contact-email {
      font-size: 1.5rem;
    }
  }
</style>
