---
import profileImg from '../assets/eric.jpeg';
---

<section class="hero">
  <div class="hero-content">
    <h1 class="hero-name">Eric Chavarría</h1>
    <p class="hero-subtitle">
      <span class="lang-en">Full Stack Engineer | AI-first Developer</span>
      <span class="lang-es">Ingeniero Full Stack | Desarrollador AI-first</span>
    </p>
    <div class="hero-cta">
      <a href="#contact" class="cta-link">
        <span class="lang-en">Contact</span>
        <span class="lang-es">Contacto</span>
        <span class="arrow">→</span>
      </a>
      <a href="#works" class="cta-link">
        <span class="lang-en">My portfolio</span>
        <span class="lang-es">Mi portafolio</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
  <div class="hero-image">
    <div class="image-wrapper">
      <img src={profileImg.src} alt="Eric Chavarría" class="profile-img" loading="lazy" />
      <div class="floating-icon icon-typescript" title="TypeScript">
