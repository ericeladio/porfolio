---
import CircuitBackground from '../components/CircuitBackground.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Full Stack Engineer specializing in AI-first development. Portfolio of Eric Chavarría.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://erichavarria.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="full stack, developer, AI, TypeScript, Python, React, Docker, portfolio" />
    <meta name="author" content="Eric Chavarría" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2D283E" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Eric Chavarría Portfolio" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <CircuitBackground />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
